# ---------------------------------------------------------------- ClickUp
CLICKUP_API_TOKEN=pk_xxx
# Printed by `python -m app.cli register-webhook ...`
CLICKUP_WEBHOOK_SECRET=
# Status that fires the automation (case-insensitive)
CLICKUP_TRIGGER_STATUS=push to facebook
# Optional: move the task here afterwards (statuses must exist on the list)
CLICKUP_DONE_STATUS=
CLICKUP_FAILED_STATUS=

# Custom field names on the task (case-insensitive). Defaults shown.
CLICKUP_FIELD_CAMPAIGN=Campaign
CLICKUP_FIELD_HEADLINE=Headline
CLICKUP_FIELD_CTA=CTA
CLICKUP_FIELD_LINK=Link
# Optional: if this field is empty, the first Drive link in the description is used
CLICKUP_FIELD_DRIVE=Drive Link
# Optional: if this field is empty, the task description is used
CLICKUP_FIELD_PRIMARY_TEXT=Primary Text

# ---------------------------------------------------------------- Meta
# System user token with ads_management + pages_read_engagement
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_1234567890
META_PAGE_ID=
# Optional: Instagram account to run as (otherwise Meta uses the Page)
META_INSTAGRAM_USER_ID=
META_API_VERSION=v24.0
# Ad set every new ad set is copied from (targeting, budget, placements, pixel)
META_TEMPLATE_ADSET_ID=
# PAUSED (default, review in Ads Manager) or ACTIVE (go live if every check passes)
META_AD_STATUS=PAUSED
# Optional tracking params added to the link, e.g. utm_source=facebook&utm_medium=paid
META_URL_TAGS=
# Optional: replace the built-in list of enhancements to opt out of (comma separated)
META_OPT_OUT_FEATURES=

# ---------------------------------------------------------------- Google Drive (one of)
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_API_KEY=

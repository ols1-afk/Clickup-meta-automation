# For running locally. On GitHub, these go in Settings -> Secrets and variables -> Actions.

# ---------------------------------------------------------------- ClickUp
CLICKUP_API_TOKEN=pk_xxx
# The number after app.clickup.com/ in any ClickUp URL
CLICKUP_TEAM_ID=
# Optional: only look at these lists (comma separated), from app.clickup.com/<team>/v/li/<LIST_ID>
CLICKUP_LIST_IDS=
# Statuses (must exist on the list; case-insensitive)
CLICKUP_TRIGGER_STATUS=push to facebook
CLICKUP_DONE_STATUS=in meta
CLICKUP_FAILED_STATUS=meta failed

# Custom field names (case-insensitive). Defaults shown.
CLICKUP_FIELD_CAMPAIGN=Campaign
CLICKUP_FIELD_HEADLINE=Headline
CLICKUP_FIELD_CTA=CTA
CLICKUP_FIELD_LINK=URL Destination
# If empty on a task, the task description is used instead
CLICKUP_FIELD_PRIMARY_TEXT=Primary Text 1

# ---------------------------------------------------------------- Meta
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_1234567890
META_PAGE_ID=
# Optional: Instagram account to run as
META_INSTAGRAM_USER_ID=
META_API_VERSION=v24.0
# Ad set every new ad set is copied from (targeting, budget, placements, pixel)
META_TEMPLATE_ADSET_ID=
# PAUSED (default, review in Ads Manager) or ACTIVE (go live if every check passes)
META_AD_STATUS=PAUSED
# Optional tracking params, e.g. utm_source=facebook&utm_medium=paid
META_URL_TAGS=
# Optional: replace the built-in list of enhancements to opt out of (comma separated)
META_OPT_OUT_FEATURES=

# ---------------------------------------------------------------- Google Drive (optional)
# Only needed if some tasks link a Drive folder instead of attaching the images.
GOOGLE_SERVICE_ACCOUNT_JSON=
CLICKUP_FIELD_DRIVE=Drive Link
